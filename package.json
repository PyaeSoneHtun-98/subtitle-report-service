{
  "name": "subtitle-report-service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Private Next.js dictionary report inbox and HTTPS reporting relay.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/check-storage.mjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test tests/*.test.mjs && vitest run",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^26.1.0",
    "vitest": "^5.0.3"
  }
}
